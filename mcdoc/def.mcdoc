type PackId = ::slimecore::mcdoc::def::PackId

// matches <pack_id>:<path>
type CffectId = string
// must be quotable
type CffectRegistrationName = string
type StartCommand = #[command] string
type TickCommand = #[command] string
type EndCommand = #[command] string
type MergeCommand = #[command] string
type CffectData = any
type InstanceId = int
type Gametime = int

struct CffectRegistrationInfo {
    pack_id: PackId,
    name: CffectRegistrationName,
}

struct CffectBody {
    start?: StartCommand,
    tick?: TickCommand,
    end?: EndCommand,
    merge?: MergeCommand,
}

struct CffectDefinition {
    registration: CffectRegistrationInfo,
    id: CffectId,
    ...CffectBody,
}

struct CffectInstance {
    id: CffectId,
    instance_id: InstanceId,
    data: CffectData,
    end_time: Gametime,
    tick?: struct {
        enabled: true,
        command: TickCommand,
    },
}

struct EntityEntry {
    uuid: #[uuid] [int] @ 4,
    cffects: [CffectInstance],
}

struct CommonGiveIn {
    id: CffectId,
    duration: int,
    // default: {}
    data?: CffectData,
}
type ReturnSuccessCount = int @ 0..

enum(int) GiveReturnFailure {
    NoDefinitionForId = -1,
    InvalidDuration = -2,
}
type GiveReturn = (ReturnSuccessCount | GiveReturnFailure)

struct CommonRemoveIn {
    id: CffectId,
}

struct InputTarget {
    uuid: #[uuid] [int] @ 4,
}